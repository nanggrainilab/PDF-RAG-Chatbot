# Salin file ini menjadi ".env" lalu isi API key kamu.
# Dapatkan GOOGLE_API_KEY gratis di https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=isi_api_key_google_ai_studio_disini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

APP_TITLE=PDF Chat
